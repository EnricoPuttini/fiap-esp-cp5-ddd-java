<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>br.com.fiap.bank</groupId>
    <artifactId>fiap-bank-core-bancario</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>FIAP Bank - Core Bancário</name>
    <description>
        Microsserviço de gestão de clientes e contas bancárias, construído do
        zero com DDD e Maven Multi-Módulo (Checkpoint 5). Hierarquia de
        dependências obrigatória: presentation -> application ->
        infrastructure e domain; infrastructure -> domain; domain isolado.
    </description>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath />
    </parent>

    <modules>
        <module>fiap-bank-core-bancario-domain</module>
        <module>fiap-bank-core-bancario-infrastructure</module>
        <module>fiap-bank-core-bancario-application</module>
        <module>fiap-bank-core-bancario-presentation</module>
    </modules>

    <properties>
        <java.version>21</java.version>
    </properties>

    <!-- Centraliza as versões dos módulos internos; cada submódulo declara só o que usa. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>br.com.fiap.bank</groupId>
                <artifactId>fiap-bank-core-bancario-domain</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.fiap.bank</groupId>
                <artifactId>fiap-bank-core-bancario-infrastructure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.fiap.bank</groupId>
                <artifactId>fiap-bank-core-bancario-application</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.com.fiap.bank</groupId>
                <artifactId>fiap-bank-core-bancario-presentation</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                            <version>${lombok.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
