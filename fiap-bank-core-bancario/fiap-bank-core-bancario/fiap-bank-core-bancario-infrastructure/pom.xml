<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>br.com.fiap.bank</groupId>
        <artifactId>fiap-bank-core-bancario</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>fiap-bank-core-bancario-infrastructure</artifactId>
    <packaging>jar</packaging>

    <name>FIAP Bank - Core Bancário - Infrastructure</name>
    <description>
        Suporte a dados sob a arquitetura Ports &amp; Adapters: Entidades JPA,
        interfaces Spring Data JPA e os Repository Adapters que implementam
        as portas de repositório definidas pelo domain.
    </description>

    <dependencies>
        <dependency>
            <groupId>br.com.fiap.bank</groupId>
            <artifactId>fiap-bank-core-bancario-domain</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Regra 1 do CP5: infrastructure só pode enxergar domain. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-infrastructure-boundaries</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>br.com.fiap.bank:fiap-bank-core-bancario-application</exclude>
                                        <exclude>br.com.fiap.bank:fiap-bank-core-bancario-presentation</exclude>
                                    </excludes>
                                    <message>
                                        O módulo infrastructure só pode depender de domain. Dependências
                                        diretas de application ou presentation violam a hierarquia Maven.
                                    </message>
                                </bannedDependencies>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
